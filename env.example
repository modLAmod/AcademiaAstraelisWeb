<!DOCTYPE html>
<html lang="es">
<head>
  <title>Panel de staff · Archivo de Rol</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="layout">
    <% var active = 'staff' %>
    <%- include('partials/nav', { user }) %>

    <main class="content">
      <header class="content__header">
        <h1>Panel de staff</h1>
        <p class="content__lede">Revisa, aprueba o deniega las fichas presentadas.</p>
      </header>

      <% if (ok) { %><p class="alert alert--ok"><%= ok %></p><% } %>

      <nav class="tabs">
        <a class="tabs__link <%= !filtro ? 'is-active' : '' %>" href="/staff">Todas</a>
        <a class="tabs__link <%= filtro === 'pendiente' ? 'is-active' : '' %>" href="/staff?status=pendiente">Pendientes</a>
        <a class="tabs__link <%= filtro === 'aprobada' ? 'is-active' : '' %>" href="/staff?status=aprobada">Aprobadas</a>
        <a class="tabs__link <%= filtro === 'denegada' ? 'is-active' : '' %>" href="/staff?status=denegada">Denegadas</a>
      </nav>

      <% if (fichas.length === 0) { %>
        <p class="empty">No hay fichas que coincidan con este filtro.</p>
      <% } %>

      <div class="staff-list">
        <% fichas.forEach(function(f) { %>
          <article class="staff-card">
            <div class="staff-card__top">
              <img
                class="staff-card__avatar"
                src="<%= f.avatar ? `https://cdn.discordapp.com/avatars/${f.user_id}/${f.avatar}.png` : `https://cdn.discordapp.com/embed/avatars/0.png` %>"
                alt=""
              />
              <div>
                <h2><%= f.nombre_personaje %></h2>
                <span class="staff-card__owner">presentada por <%= f.username %></span>
              </div>
              <div class="stamp stamp--<%= f.status %> stamp--small">
                <%= f.status === 'pendiente' ? 'Pendiente' : f.status === 'aprobada' ? 'Aprobada' : 'Denegada' %>
              </div>
            </div>

            <dl class="staff-card__meta">
              <% if (f.edad) { %><div><dt>Edad</dt><dd><%= f.edad %></dd></div><% } %>
              <% if (f.raza) { %><div><dt>Raza</dt><dd><%= f.raza %></dd></div><% } %>
            </dl>

            <% if (f.historia) { %>
              <p class="staff-card__excerpt"><%= f.historia.slice(0, 220) %><%= f.historia.length > 220 ? '…' : '' %></p>
            <% } %>

            <% if (f.status === 'denegada' && f.motivo_denegacion) { %>
              <p class="callout callout--denegada callout--small">
                <strong>Motivo:</strong> <%= f.motivo_denegacion %>
              </p>
            <% } %>

            <div class="staff-card__actions">
              <% if (f.status !== 'aprobada') { %>
                <form action="/staff/<%= f.id %>/aprobar" method="POST">
                  <button class="btn btn--small btn--success" type="submit">Aceptar</button>
                </form>
              <% } %>

              <% if (f.status !== 'denegada') { %>
                <details class="deny-box">
                  <summary class="btn btn--small btn--danger">Denegar</summary>
                  <form action="/staff/<%= f.id %>/denegar" method="POST" class="deny-box__form">
                    <textarea name="motivo" rows="2" placeholder="Motivo de la denegación (se le mostrará al usuario)"></textarea>
                    <button class="btn btn--small btn--danger" type="submit">Confirmar denegación</button>
                  </form>
                </details>
              <% } %>

              <form action="/staff/<%= f.id %>/eliminar" method="POST"
                onsubmit="return confirm('¿Eliminar esta ficha? El usuario podrá crear una nueva desde cero.');">
                <button class="btn btn--small btn--ghost" type="submit">Eliminar</button>
              </form>
            </div>
          </article>
        <% }); %>
      </div>
    </main>
  </div>
</body>
</html>
